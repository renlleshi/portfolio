{
  "name": "Security Alert Triage & Summarization",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "security-alert-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "3c3c3c3c-0001-4c3c-9c3c-000000000001",
      "name": "Security Alert Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nreturn [{\n  json: {\n    source: b.source || 'unknown',\n    alertType: b.alert_type || b.type || 'unspecified',\n    user: b.user || b.account || 'unknown',\n    ip: b.ip || 'unknown',\n    description: b.description || b.message || JSON.stringify(b),\n    raw_timestamp: b.timestamp || new Date().toISOString()\n  }\n}];"
      },
      "id": "3c3c3c3c-0002-4c3c-9c3c-000000000002",
      "name": "Normalize Alert Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-80, 0]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a Tier-1 SOC triage assistant. Given a normalized security alert, classify its severity and write a short human-readable summary plus a recommended next action for the on-call analyst. Do not invent facts not present in the alert. Respond with ONLY valid JSON: {\"severity\": \"low|medium|high|critical\", \"summary\": \"...\", \"recommended_action\": \"...\"}."
            },
            {
              "role": "user",
              "content": "=Source: {{ $json.source }}\nAlert type: {{ $json.alertType }}\nUser/Account: {{ $json.user }}\nIP: {{ $json.ip }}\nDescription: {{ $json.description }}\nTimestamp: {{ $json.raw_timestamp }}"
            }
          ]
        },
        "options": { "temperature": 0.1 }
      },
      "id": "3c3c3c3c-0003-4c3c-9c3c-000000000003",
      "name": "Classify Severity & Summarize",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [160, 0],
      "credentials": {
        "openAiApi": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "OpenAI account" }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.message?.content || $input.first().json.text || '{}';\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = { severity: 'medium', summary: 'Could not parse AI output — manual review required.', recommended_action: 'Escalate to analyst.' };\n}\nconst prev = $('Normalize Alert Payload').first().json;\nreturn [{\n  json: {\n    ...prev,\n    severity: parsed.severity,\n    ai_summary: parsed.summary,\n    recommended_action: parsed.recommended_action,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "3c3c3c3c-0004-4c3c-9c3c-000000000004",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "mode": "list", "value": "REPLACE_WITH_YOUR_SHEET_ID" },
        "sheetName": { "mode": "list", "value": "AlertLog" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.processed_at }}",
            "Source": "={{ $json.source }}",
            "Alert Type": "={{ $json.alertType }}",
            "User": "={{ $json.user }}",
            "IP": "={{ $json.ip }}",
            "Severity": "={{ $json.severity }}",
            "AI Summary": "={{ $json.ai_summary }}",
            "Recommended Action": "={{ $json.recommended_action }}"
          }
        }
      },
      "id": "3c3c3c3c-0005-4c3c-9c3c-000000000005",
      "name": "Log to Audit Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [640, -140],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"received\", \"severity\": $json.severity } }}"
      },
      "id": "3c3c3c3c-0006-4c3c-9c3c-000000000006",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [640, 20]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-high",
              "leftValue": "={{ $json.severity }}",
              "rightValue": "high",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "cond-critical",
              "leftValue": "={{ $json.severity }}",
              "rightValue": "critical",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "3c3c3c3c-0007-4c3c-9c3c-000000000007",
      "name": "IF Severity High or Critical",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 180]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "mode": "name", "value": "security-alerts" },
        "text": "=🚨 [{{ $json.severity | upper }}] {{ $json.alertType }} — user {{ $json.user }} from {{ $json.ip }}\nSummary: {{ $json.ai_summary }}\nRecommended action: {{ $json.recommended_action }}"
      },
      "id": "3c3c3c3c-0008-4c3c-9c3c-000000000008",
      "name": "Alert Security Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [880, 180],
      "credentials": {
        "slackApi": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Slack account" }
      }
    }
  ],
  "connections": {
    "Security Alert Webhook": { "main": [[{ "node": "Normalize Alert Payload", "type": "main", "index": 0 }]] },
    "Normalize Alert Payload": { "main": [[{ "node": "Classify Severity & Summarize", "type": "main", "index": 0 }]] },
    "Classify Severity & Summarize": { "main": [[{ "node": "Parse AI Output", "type": "main", "index": 0 }]] },
    "Parse AI Output": {
      "main": [
        [
          { "node": "Log to Audit Sheet", "type": "main", "index": 0 },
          { "node": "Respond to Webhook", "type": "main", "index": 0 },
          { "node": "IF Severity High or Critical", "type": "main", "index": 0 }
        ]
      ]
    },
    "IF Severity High or Critical": { "main": [ [{ "node": "Alert Security Channel", "type": "main", "index": 0 }], [] ] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false }
}
