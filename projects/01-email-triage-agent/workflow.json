{
  "name": "AI Email Triage & Auto-Draft Agent",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            { "mode": "everyMinute" }
          ]
        },
        "simple": false,
        "filters": {
          "readStatus": "unread"
        }
      },
      "id": "1a1b1c1d-0001-4a1a-9a1a-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [-300, 0],
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Gmail account" }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "from", "type": "string", "value": "={{ $json.from.value[0].address }}" },
            { "id": "a2", "name": "subject", "type": "string", "value": "={{ $json.subject }}" },
            { "id": "a3", "name": "body", "type": "string", "value": "={{ $json.text }}" },
            { "id": "a4", "name": "messageId", "type": "string", "value": "={{ $json.id }}" }
          ]
        }
      },
      "id": "1a1b1c1d-0002-4a1a-9a1a-000000000002",
      "name": "Extract Email Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-60, 0]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an inbox triage assistant for a small business. Classify the incoming email and draft a short, professional reply. Respond with ONLY valid JSON in this exact shape: {\"category\": \"Sales|Support|Urgent|Spam\", \"priority\": \"low|normal|high\", \"draft_reply\": \"...\"}. Keep the draft reply under 80 words. If the email is clearly spam or irrelevant, set category to Spam and draft_reply to an empty string."
            },
            {
              "role": "user",
              "content": "=From: {{ $json.from }}\nSubject: {{ $json.subject }}\n\nBody:\n{{ $json.body }}"
            }
          ]
        },
        "options": { "temperature": 0.3 }
      },
      "id": "1a1b1c1d-0003-4a1a-9a1a-000000000003",
      "name": "Classify & Draft with AI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [180, 0],
      "credentials": {
        "openAiApi": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "OpenAI account" }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.message?.content || $input.first().json.text || '{}';\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = { category: 'Support', priority: 'normal', draft_reply: '' };\n}\nreturn [{\n  json: {\n    from: $('Extract Email Data').first().json.from,\n    subject: $('Extract Email Data').first().json.subject,\n    messageId: $('Extract Email Data').first().json.messageId,\n    category: parsed.category,\n    priority: parsed.priority,\n    draft_reply: parsed.draft_reply,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "1a1b1c1d-0004-4a1a-9a1a-000000000004",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "mode": "list", "value": "REPLACE_WITH_YOUR_SHEET_ID" },
        "sheetName": { "mode": "list", "value": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "From": "={{ $json.from }}",
            "Subject": "={{ $json.subject }}",
            "Category": "={{ $json.category }}",
            "Priority": "={{ $json.priority }}",
            "Processed At": "={{ $json.processed_at }}"
          }
        }
      },
      "id": "1a1b1c1d-0005-4a1a-9a1a-000000000005",
      "name": "Log to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [680, -140],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-spam",
              "leftValue": "={{ $json.category }}",
              "rightValue": "Spam",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "1a1b1c1d-0006-4a1a-9a1a-000000000006",
      "name": "IF Is Spam",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 20]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "message": "={{ $json.draft_reply }}",
        "options": {
          "sendTo": "={{ $json.from }}",
          "subject": "=Re: {{ $json.subject }}"
        }
      },
      "id": "1a1b1c1d-0007-4a1a-9a1a-000000000007",
      "name": "Create Gmail Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [920, 60],
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Gmail account" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-urgent",
              "leftValue": "={{ $json.priority }}",
              "rightValue": "high",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "1a1b1c1d-0008-4a1a-9a1a-000000000008",
      "name": "IF Is Urgent",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 180]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "mode": "name", "value": "inbox-alerts" },
        "text": "=🔴 Urgent email from *{{ $json.from }}*\nSubject: {{ $json.subject }}\nSuggested reply drafted in Gmail — please review and send."
      },
      "id": "1a1b1c1d-0009-4a1a-9a1a-000000000009",
      "name": "Notify Slack (Urgent)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [920, 180],
      "credentials": {
        "slackApi": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Slack account" }
      }
    }
  ],
  "connections": {
    "Gmail Trigger": { "main": [[{ "node": "Extract Email Data", "type": "main", "index": 0 }]] },
    "Extract Email Data": { "main": [[{ "node": "Classify & Draft with AI", "type": "main", "index": 0 }]] },
    "Classify & Draft with AI": { "main": [[{ "node": "Parse AI Output", "type": "main", "index": 0 }]] },
    "Parse AI Output": {
      "main": [
        [
          { "node": "Log to Sheet", "type": "main", "index": 0 },
          { "node": "IF Is Spam", "type": "main", "index": 0 },
          { "node": "IF Is Urgent", "type": "main", "index": 0 }
        ]
      ]
    },
    "IF Is Spam": { "main": [ [], [{ "node": "Create Gmail Draft", "type": "main", "index": 0 }] ] },
    "IF Is Urgent": { "main": [ [{ "node": "Notify Slack (Urgent)", "type": "main", "index": 0 }], [] ] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false }
}
